# Java and Spring Boot project .gitignore (perfect for Maven, H2, IntelliJ, Eclipse etc)

# Compiled class files
*.class

# JAR, WAR, EAR, ZIP artifacts
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven target build directory
/target/

# Eclipse
.classpath
.project
.settings/
.springBeans
.apt_generated
.factorypath

# STS
.sts4-cache

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/
# IntelliJ project workspace and gradle caches
*.gpg
.gradle/
build/
# JetBrains IDE user-specific files/folders
*.sublime-workspace
*.sublime-project

# VS Code
.vscode/

# macOS & Windows system files
.DS_Store
Thumbs.db

# Node / Yarn / npm (exclude in case frontend is added in the future)
node_modules/
yarn.lock
package-lock.json

# H2 Database (if file-based DBs are used, otherwise just keep screenshots)
/*.mv.db
/*.h2.db

# Local test/output files
*.tmp
*.bak

# ignore assets folder if you want to keep screenshots only in repo:
# !assets/
# Uncomment above line if you always want to keep /assets

# Ignore environment files (.env, secrets, etc)
.env*
.secret*
.secrets/
*.env

# Misc
*.swp
*.swo
*.orig
*.rej

# Exclude backup files
*~
*.bak

# Explicitly keep your screenshots and docs
!/assets/
